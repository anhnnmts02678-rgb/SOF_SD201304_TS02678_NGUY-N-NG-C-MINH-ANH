[32m+[m[32m# 2. Đối tượng sử dụng hệ thống[m
[32m+[m
[32m+[m[32mHệ thống có 4 nhóm người dùng chính:[m
[32m+[m
[32m+[m[32m## 2.1. Khách vãng lai (Guest)[m
[32m+[m
[32m+[m[32mNgười chưa đăng nhập vào hệ thống.[m
[32m+[m
[32m+[m[32mCác chức năng:[m
[32m+[m[32m- Xem trang chủ.[m
[32m+[m[32m- Xem danh sách sản phẩm.[m
[32m+[m[32m- Tìm kiếm sản phẩm.[m
[32m+[m[32m- Xem thông tin chi tiết sản phẩm.[m
[32m+[m[32m- Đăng ký tài khoản.[m
[32m+[m[32m- Đăng nhập.[m
[32m+[m
[32m+[m[32m## 2.2. Khách hàng (Customer)[m
[32m+[m
[32m+[m[32mNgười đã đăng ký và đăng nhập vào hệ thống.[m
[32m+[m
[32m+[m[32mCác chức năng:[m
[32m+[m[32m- Quản lý thông tin cá nhân.[m
[32m+[m[32m- Xem và tìm kiếm sản phẩm.[m
[32m+[m[32m- Thêm sản phẩm vào giỏ hàng.[m
[32m+[m[32m- Cập nhật số lượng sản phẩm trong giỏ hàng.[m
[32m+[m[32m- Xóa sản phẩm khỏi giỏ hàng.[m
[32m+[m[32m- Đặt hàng và thực hiện thanh toán.[m
[32m+[m[32m- Xem lịch sử đơn hàng.[m
[32m+[m[32m- Xem chi tiết đơn hàng.[m
[32m+[m[32m- Sử dụng mã khuyến mãi.[m
[32m+[m[32m- Đánh giá sản phẩm.[m
[32m+[m[32m- Đăng xuất.[m
[32m+[m
[32m+[m[32m## 2.3. Nhân viên (Employee)[m
[32m+[m
[32m+[m[32mNgười được cấp tài khoản nhân viên để quản lý các nghiệp vụ của cửa hàng.[m
[32m+[m
[32m+[m[32mCác chức năng:[m
[32m+[m[32m- Quản lý sản phẩm.[m
[32m+[m[32m- Quản lý thông tin khách hàng.[m
[32m+[m[32m- Quản lý đơn hàng.[m
[32m+[m[32m- Quản lý đánh giá sản phẩm.[m
[32m+[m[32m- Xem nhật ký hoạt động.[m
[32m+[m[32m- Đăng xuất.[m
[32m+[m
[32m+[m[32m## 2.4. Quản trị viên (Admin)[m
[32m+[m
[32m+[m[32mNgười có quyền quản lý và giám sát hoạt động của hệ thống.[m
[32m+[m
[32m+[m[32mCác chức năng:[m
[32m+[m[32m- Quản lý sản phẩm.[m
[32m+[m[32m- Quản lý khách hàng.[m
[32m+[m[32m- Quản lý nhân viên.[m
[32m+[m[32m- Quản lý chương trình khuyến mãi.[m
[32m+[m[32m- Quản lý đơn hàng.[m
[32m+[m[32m- Xem thống kê hoạt động kinh doanh.[m
[32m+[m[32m- Đăng xuất.[m
[32m+[m
[32m+[m[32m# 3. Mô tả các chức năng chính[m
[32m+[m
[32m+[m[32m## 3.1. Quản lý tài khoản và xác thực[m
[32m+[m
[32m+[m[32mHệ thống hỗ trợ đăng ký, đăng nhập, đăng xuất và khôi phục mật khẩu.[m
[32m+[m
[32m+[m[32m- Khách hàng đăng ký tài khoản bằng thông tin cá nhân.[m
[32m+[m[32m- Hệ thống sử dụng mã OTP để xác minh quá trình đăng ký.[m
[32m+[m[32m- Người dùng đăng nhập bằng thông tin tài khoản và mật khẩu.[m
[32m+[m[32m- Hệ thống phân biệt quyền truy cập giữa khách hàng, nhân viên và quản trị viên.[m
[32m+[m[32m- Người dùng có thể đăng xuất khỏi hệ thống.[m
[32m+[m[32m- Hỗ trợ chức năng quên mật khẩu và đặt lại mật khẩu thông qua xác minh OTP.[m
[32m+[m
[32m+[m[32m## 3.2. Quản lý sản phẩm[m
[32m+[m
[32m+[m[32mHệ thống cho phép hiển thị và quản lý thông tin sản phẩm linh kiện máy tính.[m
[32m+[m
[32m+[m[32mThông tin sản phẩm gồm:[m
[32m+[m[32m- Mã sản phẩm.[m
[32m+[m[32m- Tên sản phẩm.[m
[32m+[m[32m- Số lượng tồn kho.[m
[32m+[m[32m- Mô tả sản phẩm.[m
[32m+[m[32m- Giá thành.[m
[32m+[m[32m- Hình ảnh.[m
[32m+[m[32m- Danh mục sản phẩm.[m
[32m+[m[32m- Nhân viên phụ trách.[m
[32m+[m[32m- Chương trình khuyến mãi.[m
[32m+[m[32m- Nguồn gốc.[m
[32m+[m[32m- Trạng thái sản phẩm.[m
[32m+[m
[32m+[m[32mKhách hàng có thể xem danh sách và thông tin chi tiết sản phẩm. Nhân viên và quản trị viên có thể thực hiện các nghiệp vụ quản lý sản phẩm theo quyền được cấp.[m
[32m+[m
[32m+[m[32m## 3.3. Quản lý danh mục sản phẩm[m
[32m+[m
[32m+[m[32mHệ thống phân loại sản phẩm theo danh mục nhằm hỗ trợ khách hàng tìm kiếm và lựa chọn sản phẩm thuận tiện hơn.[m
[32m+[m
[32m+[m[32mThông tin danh mục gồm mã danh mục, tên danh mục và ghi chú.[m
[32m+[m
[32m+[m[32m## 3.4. Tìm kiếm sản phẩm[m
[32m+[m
[32m+[m[32mHệ thống hỗ trợ tìm kiếm sản phẩm theo tên và lọc sản phẩm theo danh mục.[m
[32m+[m
[32m+[m[32mKết quả tìm kiếm được hiển thị dưới dạng danh sách sản phẩm phù hợp với thông tin người dùng cung cấp.[m
[32m+[m
[32m+[m[32m## 3.5. Quản lý giỏ hàng[m
[32m+[m
[32m+[m[32mKhách hàng có thể thêm sản phẩm vào giỏ hàng trước khi đặt mua.[m
[32m+[m
[32m+[m[32mCác chức năng:[m
[32m+[m[32m- Thêm sản phẩm vào giỏ hàng.[m
[32m+[m[32m- Cập nhật số lượng sản phẩm.[m
[32m+[m[32m- Xóa sản phẩm khỏi giỏ hàng.[m
[32m+[m[32m- Xem thông tin sản phẩm trong giỏ hàng.[m
[32m+[m[32m- Tính tổng giá trị giỏ hàng.[m
[32m+[m
[32m+[m[32m## 3.6. Quản lý đơn hàng[m
[32m+[m
[32m+[m[32mHệ thống hỗ trợ khách hàng tạo và theo dõi đơn hàng.[m
[32m+[m
[32m+[m[32mCác chức năng:[m
[32m+[m[32m- Tạo đơn hàng từ giỏ hàng.[m
[32m+[m[32m- Lưu thông tin sản phẩm trong đơn hàng.[m
[32m+[m[32m- Tính tổng giá trị đơn hàng.[m
[32m+[m[32m- Xem lịch sử đơn hàng.[m
[32m+[m[32m- Xem chi tiết đơn hàng.[m
[32m+[m[32m- Theo dõi trạng thái đơn hàng.[m
[32m+[m[32m- Nhân viên và quản trị viên thực hiện nghiệp vụ quản lý đơn hàng theo quyền được cấp.[m
[32m+[m
[32m+[m[32m## 3.7. Quản lý thanh toán[m
[32m+[m
[32m+[m[32mHệ thống lưu trữ thông tin thanh toán liên quan đến đơn hàng.[m
[32m+[m
[32m+[m[32mThông tin thanh toán gồm:[m
[32m+[m[32m- Mã thanh toán.[m
[32m+[m[32m- Phương thức thanh toán.[m
[32m+[m[32m- Trạng thái thanh toán.[m
[32m+[m[32m- Thời gian thanh toán.[m
[32m+[m[32m- Mã giao dịch.[m
[32m+[m
[32m+[m[32mThông tin thanh toán được liên kết với hóa đơn tương ứng.[m
[32m+[m
[32m+[m[32m## 3.8. Quản lý khuyến mãi[m
[32m+[m
[32m+[m[32mHệ thống hỗ trợ quản lý các chương trình khuyến mãi dành cho sản phẩm hoặc đơn hàng.[m
[32m+[m
[32m+[m[32mThông tin khuyến mãi gồm:[m
[32m+[m[32m- Mã khuyến mãi.[m
[32m+[m[32m- Loại khuyến mãi.[m
[32m+[m[32m- Phần trăm giảm giá.[m
[32m+[m[32m- Ngày bắt đầu.[m
[32m+[m[32m- Ngày kết thúc.[m
[32m+[m[32m- Mô tả.[m
[32m+[m[32m- Trạng thái.[m
[32m+[m
[32m+[m[32mQuản trị viên có thể quản lý thông tin chương trình khuyến mãi. Khách hàng có thể sử dụng chương trình khuyến mãi khi mua hàng theo điều kiện áp dụng của hệ thống.[m
[32m+[m
[32m+[m[32m## 3.9. Đánh giá sản phẩm[m
[32m+[m
[32m+[m[32mKhách hàng có thể gửi đánh giá đối với sản phẩm đã mua.[m
[32m+[m
[32m+[m[32mThông tin đánh giá gồm:[m
[32m+[m[32m- Mã đánh giá.[m
[32m+[m[32m- Khách hàng thực hiện đánh giá.[m
[32m+[m[32m- Sản phẩm được đánh giá.[m
[32m+[m[32m- Số sao.[m
[32m+[m[32m- Nội dung đánh giá.[m
[32m+[m[32m- Hình ảnh đính kèm.[m
[32m+[m[32m- Thời gian đánh giá.[m
[32m+[m
[32m+[m[32mHệ thống hỗ trợ hiển thị đánh giá sản phẩm và quản lý các đánh giá đã gửi.[m
[32m+[m
[32m+[m[32m## 3.10. Quản lý khách hàng[m
[32m+[m
[32m+[m[32mHệ thống lưu trữ và quản lý thông tin khách hàng.[m
[32m+[m
[32m+[m[32mThông tin khách hàng gồm:[m
[32m+[m[32m- Mã khách hàng.[m
[32m+[m[32m- Họ và tên.[m
[32m+[m[32m- Số điện thoại.[m
[32m+[m[32m- Email.[m
[32m+[m[32m- Mật khẩu.[m
[32m+[m[32m- Địa chỉ.[m
[32m+[m[32m- Trạng thái tài khoản.[m
[32m+[m
[32m+[m[32mNhân viên và quản trị viên có thể quản lý thông tin khách hàng theo quyền được cấp.[m
[32m+[m
[32m+[m[32m## 3.11. Quản lý nhân viên[m
[32m+[m
[32m+[m[32mHệ thống lưu trữ thông tin tài khoản nhân viên phục vụ hoạt động quản lý cửa hàng.[m
[32m+[m
[32m+[m[32mThông tin nhân viên gồm:[m
[32m+[m[32m- Mã nhân viên.[m
[32m+[m[32m- Họ và tên.[m
[32m+[m[32m- Tên đăng nhập.[m
[32m+[m[32m- Email.[m
[32m+[m[32m- Mật khẩu.[m
[32m+[m[32m- Số điện thoại.[m
[32m+[m[32m- Ngày tạo tài khoản.[m
[32m+[m[32m- Trạng thái tài khoản.[m
[32m+[m
[32m+[m[32mQuản trị viên có thể quản lý danh sách nhân viên.[m
[32m+[m
[32m+[m[32m## 3.12. Nhật ký hoạt động[m
[32m+[m
[32m+[m[32mHệ thống lưu lại thông tin về các hoạt động quản lý được thực hiện bởi nhân viên hoặc quản trị viên.[m
[32m+[m
[32m+[m[32mThông tin nhật ký gồm:[m
[32m+[m[32m- Mã nhật ký.[m
[32m+[m[32m- Nhân viên thực hiện.[m
[32m+[m[32m- Quản trị viên thực hiện.[m
[32m+[m[32m- Hành động.[m
[32m+[m[32m- Mô tả.[m
[32m+[m[32m- Thời gian thực hiện.[m
[32m+[m
[32m+[m[32m## 3.13. Thống kê[m
[32m+[m
[32m+[m[32mHệ thống hỗ trợ thống kê một số thông tin tổng quan phục vụ quản lý cửa hàng.[m
[32m+[m
[32m+[m[32mCác thông tin thống kê gồm:[m
[32m+[m[32m- Tổng số sản phẩm.[m
[32m+[m[32m- Tổng số khách hàng.[m
[32m+[m[32m- Tổng số nhân viên.[m
[32m+[m[32m- Tổng số hóa đơn.[m
[32m+[m[32m- Thời gian cập nhật thống kê.[m
[32m+[m
